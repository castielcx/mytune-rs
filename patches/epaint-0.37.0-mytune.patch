+    /// One smooth corner of a rectangle: `corner` is the rectangle's own corner point, `r` the corner radius and
+    /// `a >= r` how far along each side the curve reaches. Quadrants as in `add_circle_quadrant`.
+    fn add_smooth_quadrant(path: &mut Vec<Pos2>, corner: Pos2, r: f32, a: f32, quadrant: f32) {
+        let mut push = |p: Pos2| {
